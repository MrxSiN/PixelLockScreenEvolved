<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
        The module has no screen of its own. Clock styles are offered in the
        system's own Wallpaper & style picker, beside the clocks they join.
    -->
    <application
        android:allowBackup="false"
        android:description="@string/module_description"
        android:hasCode="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true">

        <!--
            Finds the subject of the lock screen photo for the depth effect.
            SystemUI binds to it; it answers no other caller.
        -->
        <service
            android:name=".depth.SubjectMaskService"
            android:exported="true" />
    </application>

</manifest>
